---
/**
 * A table to move around in, showing what VoiceOver said for each move. The phrases are recordings, not rules:
 * `src/data/accessible-pdfs-voiceover.json` has, for each of three PDFs of the same table, what VoiceOver with
 * Preview spoke on arriving at each cell from each side. See src/content/posts/accessible-pdfs.mdx for usage.
 */
import speech from "@/data/accessible-pdfs-voiceover.json";

const grid = [
  ["Student", "Autumn", "Spring"],
  ["Ada", "9", "8"],
  ["Ben", "7", "6"],
];
const versions = [
  { id: "bold-row", label: "No header cells", detail: "a bold first row" },
  { id: "column-headers-only", label: "Header row", detail: "column headers" },
  {
    id: "row-headers",
    label: "Header row and row headers",
    detail: "column and row headers",
  },
];
---

<figure
  class="table-listen"
  data-speech={JSON.stringify(speech)}
  data-version="bold-row"
>
  <div
    class="tl-switch"
    role="radiogroup"
    aria-label="How the table was written"
  >
    {
      versions.map((version, index) => (
        <button
          type="button"
          role="radio"
          aria-checked={index === 0 ? "true" : "false"}
          tabindex={index === 0 ? 0 : -1}
          data-version={version.id}
        >
          {version.label}
        </button>
      ))
    }
  </div>

  <div class="tl-stage">
    <div
      class="tl-grid"
      tabindex="0"
      role="group"
      aria-label="The table. Move with the arrow keys."
    >
      {
        grid.map((row, r) => (
          <div class="tl-row">
            {row.map((text, c) => (
              <button
                type="button"
                class="tl-cell"
                tabindex="-1"
                data-cell={`${r},${c}`}
                data-header-row={r === 0 ? "true" : "false"}
              >
                {text}
              </button>
            ))}
          </div>
        ))
      }
    </div>
    <div class="tl-pad" role="group" aria-label="Move">
      <button type="button" data-move="up" aria-label="Move up">↑</button>
      <button type="button" data-move="left" aria-label="Move left">←</button>
      <button type="button" data-move="down" aria-label="Move down">↓</button>
      <button type="button" data-move="right" aria-label="Move right">→</button>
    </div>
  </div>

  <div class="tl-said">
    <p class="tl-label">VoiceOver says</p>
    <p class="tl-phrase" aria-live="polite"></p>
    <ol class="tl-log" aria-label="Earlier moves, newest first"></ol>
  </div>

  <figcaption>
    Move with the arrow keys, the arrow buttons, or a click on a neighbouring
    cell, then switch version and make the same moves. Every phrase is a
    recording of VoiceOver reading that PDF in Preview on macOS 26.6.
  </figcaption>
</figure>

<script>
  type Speech = Record<string, Record<string, Record<string, string>>>;
  const steps: Record<string, [number, number]> = {
    up: [-1, 0],
    down: [1, 0],
    left: [0, -1],
    right: [0, 1],
  };
  const keys: Record<string, string> = {
    ArrowUp: "up",
    ArrowDown: "down",
    ArrowLeft: "left",
    ArrowRight: "right",
  };
  const arrows: Record<string, string> = {
    up: "↑",
    down: "↓",
    left: "←",
    right: "→",
  };

  function setUp(figure: HTMLElement) {
    if (figure.dataset.ready === "true") return;
    figure.dataset.ready = "true";
    const speech: Speech = JSON.parse(figure.dataset.speech ?? "{}");
    const radios = [
      ...figure.querySelectorAll<HTMLButtonElement>(".tl-switch button"),
    ];
    const cells = [...figure.querySelectorAll<HTMLButtonElement>(".tl-cell")];
    const gridElement = figure.querySelector<HTMLElement>(".tl-grid")!;
    const phrase = figure.querySelector<HTMLElement>(".tl-phrase")!;
    const log = figure.querySelector<HTMLElement>(".tl-log")!;
    let version = figure.dataset.version ?? "bold-row";
    let row = 0;
    let col = 0;

    const show = (direction: string, said: string) => {
      const previous = phrase.textContent;
      if (previous) {
        const item = document.createElement("li");
        item.textContent = previous;
        log.prepend(item);
        while (log.children.length > 5) log.lastElementChild?.remove();
      }
      phrase.textContent = `${arrows[direction] ? `${arrows[direction]} ` : ""}“${said}”`;
    };
    const mark = () => {
      for (const cell of cells)
        cell.dataset.current =
          cell.dataset.cell === `${row},${col}` ? "true" : "false";
    };
    const start = () => {
      row = 0;
      col = 0;
      log.replaceChildren();
      phrase.textContent = "";
      show("", speech[version]?.["0,0"]?.enter ?? "");
      mark();
    };
    const move = (direction: string) => {
      const [dRow, dCol] = steps[direction];
      const said =
        speech[version]?.[`${row + dRow},${col + dCol}`]?.[direction];
      // No cell that way, or no recording of that move: stay.
      if (said === undefined) return;
      row += dRow;
      col += dCol;
      show(direction, said);
      mark();
    };

    for (const radio of radios) {
      radio.addEventListener("click", () => {
        version = radio.dataset.version!;
        figure.dataset.version = version;
        for (const each of radios) {
          each.setAttribute("aria-checked", each === radio ? "true" : "false");
          each.tabIndex = each === radio ? 0 : -1;
        }
        start();
      });
      radio.addEventListener("keydown", event => {
        const step =
          event.key === "ArrowRight" || event.key === "ArrowDown"
            ? 1
            : event.key === "ArrowLeft" || event.key === "ArrowUp"
              ? -1
              : 0;
        if (step === 0) return;
        event.preventDefault();
        const next =
          radios[
            (radios.indexOf(radio) + step + radios.length) % radios.length
          ];
        next.focus();
        next.click();
      });
    }
    gridElement.addEventListener("keydown", event => {
      const direction = keys[event.key];
      if (!direction) return;
      event.preventDefault();
      move(direction);
    });
    for (const cell of cells) {
      cell.addEventListener("click", () => {
        const [r, c] = cell.dataset.cell!.split(",").map(Number);
        const direction = Object.keys(steps).find(
          name => row + steps[name][0] === r && col + steps[name][1] === c
        );
        if (direction) move(direction);
        gridElement.focus({ preventScroll: true });
      });
    }
    for (const button of figure.querySelectorAll<HTMLButtonElement>(
      ".tl-pad button"
    )) {
      button.addEventListener("click", () => move(button.dataset.move!));
    }
    start();
  }

  const setUpAll = () =>
    document.querySelectorAll<HTMLElement>(".table-listen").forEach(setUp);
  setUpAll();
  document.addEventListener("astro:page-load", setUpAll);
</script>

<style is:global>
  .table-listen {
    margin-block: 1.75rem;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
  }
  .table-listen button {
    font: inherit;
    /* Not inherit: the article's own text colour does not follow dark mode. */
    color: var(--foreground);
    cursor: pointer;
  }
  .table-listen .tl-switch {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .table-listen .tl-switch button {
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: transparent;
    font-size: 0.8rem;
  }
  .table-listen .tl-switch button[aria-checked="true"] {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--accent-foreground);
  }
  .table-listen .tl-stage {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    align-items: center;
    margin-top: 1rem;
  }
  .table-listen .tl-grid {
    display: grid;
    border-top: 1px solid var(--border);
    border-left: 1px solid var(--border);
    border-radius: 2px;
    outline-offset: 4px;
  }
  .table-listen .tl-row {
    display: grid;
    grid-template-columns: 7.5rem 5.5rem 5.5rem;
  }
  .table-listen .tl-cell {
    padding: 0.5rem 0.625rem;
    border: 0;
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: transparent;
    font-size: 0.95rem;
    text-align: left;
    cursor: default;
  }
  /* The first row is bold only in the version that has nothing else to mark it. */
  .table-listen[data-version="bold-row"] .tl-cell[data-header-row="true"] {
    font-weight: 700;
  }
  .table-listen .tl-cell[data-current="true"] {
    background: color-mix(in oklab, #ea580c 15%, transparent);
    box-shadow: inset 0 0 0 2px #ea580c;
  }
  .table-listen .tl-pad {
    display: grid;
    grid-template-columns: repeat(3, 2.25rem);
    grid-template-areas: ". up ." "left down right";
    gap: 0.25rem;
  }
  .table-listen .tl-pad button {
    height: 2.25rem;
    border: 1px solid var(--border);
    border-radius: 0.375rem;
    background: transparent;
    font-size: 1rem;
    line-height: 1;
  }
  .table-listen .tl-pad button:hover {
    border-color: var(--accent);
  }
  .table-listen .tl-pad [data-move="up"] {
    grid-area: up;
  }
  .table-listen .tl-pad [data-move="left"] {
    grid-area: left;
  }
  .table-listen .tl-pad [data-move="down"] {
    grid-area: down;
  }
  .table-listen .tl-pad [data-move="right"] {
    grid-area: right;
  }
  .table-listen .tl-said {
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
  }
  .table-listen .tl-label {
    margin: 0;
    color: var(--muted-foreground);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .table-listen .tl-phrase {
    min-height: 1.6em;
    margin: 0.25rem 0 0;
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.4;
  }
  .table-listen .tl-log {
    min-height: 7.5em;
    margin: 0.375rem 0 0;
    padding: 0;
    list-style: none;
    color: var(--muted-foreground);
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .table-listen .tl-log li {
    margin: 0;
    padding: 0;
  }
  .table-listen figcaption {
    margin-top: 0.5rem;
  }
</style>
