---
/**
 * Two lanes, a web page and a PDF, on the same path: what the author writes, what the browser or viewer builds
 * from it, and what a screen reader gets. Under each lane, what an automated test covers. The difference is the
 * middle step: written rules that every browser implements, against an early draft. Used at the top of
 * src/content/posts/between-pdf-tags-and-speech.mdx.
 */
const lanes = [
  {
    kind: "ok",
    title: "A web page",
    written: "HTML and ARIA",
    builder: "The browser builds a tree from it",
    apps: [] as string[],
    rules: [
      { name: "HTML-AAM", href: "https://www.w3.org/TR/html-aam-1.0/" },
      { name: "Core-AAM", href: "https://www.w3.org/TR/core-aam-1.2/" },
    ],
    rulesNote: "Written down. Every browser implements them.",
    result: "A predictable result in every browser",
    test: "An automated test checks the page",
    rest: "The browser's step follows written rules, so the result carries over",
  },
  {
    kind: "warn",
    title: "A PDF",
    written: "Tags, from your PDF generator",
    builder: "The viewer builds a tree from them",
    apps: ["Acrobat", "Firefox", "Chrome", "Preview"],
    rules: [{ name: "PDF-AAM", href: "https://w3c.github.io/aria/pdf-aam/" }],
    rulesNote: "An early draft, no tables yet. Each viewer has its own rules.",
    result: "A different result in each viewer",
    test: "A validator checks the tags",
    rest: "No settled rules for the viewer's step, and no test checks it",
  },
];
---

<figure class="mapping-lanes">
  {
    lanes.map(lane => (
      <div class={`ml-lane ml-${lane.kind}`}>
        <p class="ml-title">{lane.title}</p>
        <div class="ml-flow">
          <div class="ml-box">
            <p class="ml-key">You write</p>
            <p class="ml-value">{lane.written}</p>
          </div>
          <span class="ml-arrow" aria-hidden="true">
            →
          </span>
          <div class="ml-box ml-window">
            <div class="ml-bar" aria-hidden="true">
              <i />
              <i />
              <i />
            </div>
            <div class="ml-inner">
              <p class="ml-key">{lane.builder}</p>
              {lane.apps.length > 0 && (
                <ul class="ml-apps">
                  {lane.apps.map(app => (
                    <li>{app}</li>
                  ))}
                </ul>
              )}
              <p class="ml-rules">
                <span class="ml-rules-label">Rules</span>
                {lane.rules.map((rule, index) => (
                  <>
                    {index > 0 && ", "}
                    <a href={rule.href}>{rule.name}</a>
                  </>
                ))}
              </p>
              <p class="ml-note">{lane.rulesNote}</p>
            </div>
          </div>
          <span class="ml-arrow" aria-hidden="true">
            →
          </span>
          <div class="ml-box ml-result">
            <p class="ml-key">A screen reader gets</p>
            <p class="ml-value">{lane.result}</p>
          </div>
        </div>
        <div class="ml-cover">
          <p class="ml-test">{lane.test}</p>
          <p class="ml-rest">{lane.rest}</p>
        </div>
      </div>
    ))
  }
  <figcaption>
    The same path for a web page and a PDF. The middle step is where they
    differ.
  </figcaption>
</figure>

<style is:global>
  .mapping-lanes {
    --ml-good: #15803d;
    --ml-warn: #b45309;
    --ml-columns: minmax(0, 1fr) 1.25rem minmax(0, 1.6fr) 1.25rem minmax(0, 1fr);
    margin-block: 1.75rem;
    /* Not inherit: the article's own text colour does not follow dark mode. */
    color: var(--foreground);
    font-size: 0.85rem;
    line-height: 1.4;
  }
  [data-theme="dark"] .mapping-lanes {
    --ml-good: #5fe08f;
    --ml-warn: #fbbf24;
  }
  .mapping-lanes p,
  .mapping-lanes ul {
    margin: 0;
    padding: 0;
  }
  .mapping-lanes .ml-lane {
    --ml-tone: var(--ml-good);
    padding: 0.875rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
  }
  .mapping-lanes .ml-lane.ml-warn {
    --ml-tone: var(--ml-warn);
  }
  .mapping-lanes .ml-lane + .ml-lane {
    margin-top: 0.75rem;
  }
  .mapping-lanes .ml-title {
    font-size: 1rem;
    font-weight: 700;
  }
  .mapping-lanes .ml-flow,
  .mapping-lanes .ml-cover {
    display: grid;
    grid-template-columns: var(--ml-columns);
  }
  .mapping-lanes .ml-flow {
    align-items: stretch;
    margin-top: 0.625rem;
  }
  .mapping-lanes .ml-box {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.25rem;
    min-width: 0;
    padding: 0.625rem;
    border: 1px solid var(--border);
    border-radius: 0.375rem;
  }
  .mapping-lanes .ml-key {
    color: var(--muted-foreground);
    font-size: 0.75rem;
  }
  .mapping-lanes .ml-value {
    font-weight: 600;
  }
  .mapping-lanes .ml-result {
    border-color: var(--ml-tone);
  }
  .mapping-lanes .ml-result .ml-value {
    color: var(--ml-tone);
  }
  .mapping-lanes .ml-arrow {
    align-self: center;
    justify-self: center;
    color: var(--muted-foreground);
  }

  /* The middle box is drawn as an app window. */
  .mapping-lanes .ml-window {
    justify-content: flex-start;
    gap: 0;
    padding: 0;
    border-color: var(--foreground);
    overflow: hidden;
  }
  .mapping-lanes .ml-bar {
    display: flex;
    gap: 0.25rem;
    padding: 0.375rem 0.5rem;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--muted) 45%, transparent);
  }
  .mapping-lanes .ml-bar i {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--muted-foreground);
    opacity: 0.6;
  }
  .mapping-lanes .ml-inner {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 0.625rem;
  }
  .mapping-lanes .ml-apps {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    list-style: none;
  }
  .mapping-lanes .ml-apps li {
    margin: 0;
    padding: 0.05rem 0.4rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.7rem;
  }
  .mapping-lanes .ml-rules {
    padding: 0.375rem 0.5rem;
    border: 1px solid var(--ml-tone);
    border-radius: 0.25rem;
    font-weight: 600;
  }
  .mapping-lanes .ml-warn .ml-rules {
    border-style: dashed;
  }
  .mapping-lanes .ml-rules-label {
    display: block;
    color: var(--ml-tone);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .mapping-lanes .ml-note {
    font-size: 0.78rem;
  }

  /* What a test covers, lined up under the boxes above. */
  .mapping-lanes .ml-cover {
    margin-top: 0.5rem;
    font-size: 0.78rem;
  }
  .mapping-lanes .ml-test,
  .mapping-lanes .ml-rest {
    padding-top: 0.375rem;
    border-top: 3px solid var(--ml-good);
  }
  .mapping-lanes .ml-test {
    grid-column: 1;
  }
  .mapping-lanes .ml-rest {
    grid-column: 3 / -1;
    border-top-color: var(--ml-tone);
  }
  .mapping-lanes .ml-warn .ml-rest {
    border-top-style: dashed;
    color: var(--ml-tone);
    font-weight: 600;
  }
  .mapping-lanes figcaption {
    margin-top: 0.625rem;
    color: var(--muted-foreground);
    font-size: 0.8rem;
    text-align: center;
  }

  @media (max-width: 40rem) {
    .mapping-lanes .ml-flow,
    .mapping-lanes .ml-cover {
      grid-template-columns: minmax(0, 1fr);
    }
    .mapping-lanes .ml-arrow {
      padding-block: 0.125rem;
      transform: rotate(90deg);
    }
    .mapping-lanes .ml-cover {
      gap: 0.375rem;
    }
    .mapping-lanes .ml-test,
    .mapping-lanes .ml-rest {
      grid-column: 1;
      padding-top: 0;
      padding-left: 0.5rem;
      border-top: 0;
      border-left: 3px solid var(--ml-good);
    }
    .mapping-lanes .ml-rest {
      border-left-color: var(--ml-tone);
    }
    .mapping-lanes .ml-warn .ml-rest {
      border-left-style: dashed;
    }
  }
</style>
